---
// Demo video switcher: stacked labels on one side, one media pane on the other.
// The pane is locked to 1108×720 — the fixed window size all demos are recorded
// at — so clips are never cropped or letterboxed. Each entry renders its
// placeholder poster until a `video` path is set, at which point the pane
// becomes a <video> with native controls (incl. fullscreen).
//
// Props: `set` picks which four demos to show.
import pluginIntroVideo from '../assets/demoCarousel/PluginIntro.mp4';
import pluginIntroPoster from '../assets/demoCarousel/PluginIntro.png';
import pluginSettingsVideo from '../assets/demoCarousel/PluginSettings.mp4';
import pluginSettingsPoster from '../assets/demoCarousel/PluginSettings.png';
import pluginCustomizeVideo from '../assets/demoCarousel/PluginCustomization.mp4';
import pluginCustomizePoster from '../assets/demoCarousel/PluginCustomization.png';
import pluginExtractVideo from '../assets/demoCarousel/PluginData.mp4';
import pluginExtractPoster from '../assets/demoCarousel/PluginData.png';
import cliGenerateVideo from '../assets/demoCarousel/CommandGenerate.mp4';
import cliGeneratePoster from '../assets/demoCarousel/CommandGenerate.png';
import cliSetupVideo from '../assets/demoCarousel/CommandSetup.mp4';
import cliSetupPoster from '../assets/demoCarousel/CommandSetup.png';

interface Demo {
  id: string;
  label: string;
  description: string;
  /** render-ready URL (imported asset, or a base-prefixed public path) */
  poster: string;
  /** imported src/assets URL — already includes the base prefix */
  video?: string;
}

const sets: Record<string, Demo[]> = {
  plugin: [
    {
      id: 'plugin-generate',
      label: 'Generate canvas output',
      description: 'Add anatomy, props, layout, styling, modes and data',
      poster: pluginIntroPoster.src,
      video: pluginIntroVideo,
    },
    {
      id: 'plugin-settings',
      label: 'Match naming conventions',
      description: 'Detect your subcomponents, glyphs, and examples',
      poster: pluginSettingsPoster.src,
      video: pluginSettingsVideo,
    },
    {
      id: 'plugin-customize',
      label: 'Custom styling',
      description: 'Style color, space and text to your preferences',
      poster: pluginCustomizePoster.src,
      video: pluginCustomizeVideo,
    },
    {
      id: 'plugin-extract',
      label: 'Extract data to LLMs',
      description: 'Copy structured spec data of a library',
      poster: pluginExtractPoster.src,
      video: pluginExtractVideo,
    },
  ],
  cli: [
    {
      id: 'cli-generate',
      label: 'Generate library specs',
      description: 'Process 50 components in a minute for your pipeline',
      poster: cliGeneratePoster.src,
      video: cliGenerateVideo,
    },
    {
      id: 'cli-setup',
      label: 'Set up an environment',
      description: 'One-time setup for sources, settings and scanning',
      poster: cliSetupPoster.src,
      video: cliSetupVideo,
    },
    // Pending recording — restore once CommandTransform / CommandAnalyze
    // are added to assets/demoCarousel/ (with their .png posters + imports,
    // set the poster to `cliTransformPoster.src` / `cliAnalyzePoster.src`).
    // {
    //   id: 'cli-transform',
    //   label: 'Transform to code',
    //   description: 'Reshape data into CSS, contracts and scaffolds',
    //   poster: cliTransformPoster.src,
    //   video: cliTransformVideo,
    // },
    // {
    //   id: 'cli-analyze',
    //   label: 'Analyze system health',
    //   description: 'Track system quality of props, tokens, and beyond',
    //   poster: cliAnalyzePoster.src,
    //   video: cliAnalyzeVideo,
    // },
  ],
};

interface Props {
  set: keyof typeof sets;
}

const { set } = Astro.props;
const demos = sets[set];

// Distinct accessible names — two identically-labeled tablists on one page
// are indistinguishable to screen reader users
const navLabels: Record<string, string> = {
  plugin: 'Figma plugin demos',
  cli: 'Command demos',
};
---

{/* not-content exempts the internals from Starlight's markdown flow spacing
    (margin-top on sibling blocks), which otherwise pushes the stage 1rem
    below the nav and pads out the gap between nav items */}
<section class="demo-carousel not-content">
  <div class="demo-aside">
    <div class="demo-nav" role="tablist" aria-label={navLabels[set]} aria-orientation="vertical">
      {demos.map((demo, i) => (
        <button
          type="button"
          role="tab"
          id={`demo-tab-${demo.id}`}
          aria-controls={`demo-panel-${demo.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="demo-tab"
        >
          <span class="demo-tab-label">{demo.label}</span>
          <span class="demo-tab-desc">{demo.description}</span>
        </button>
      ))}
    </div>
  </div>
  <div class="demo-stage">
    {demos.map((demo, i) => (
      <div
        role="tabpanel"
        id={`demo-panel-${demo.id}`}
        aria-labelledby={`demo-tab-${demo.id}`}
        class="demo-panel"
        hidden={i !== 0}
        tabindex={demo.video ? undefined : 0}
      >
        {demo.video ? (
          <video
            controls
            playsinline
            preload="none"
            poster={demo.poster}
            src={demo.video}
            aria-label={`${demo.label} — ${demo.description}`}
          />
        ) : (
          <img
            src={demo.poster}
            alt={`${demo.label} — video coming soon`}
            loading={i === 0 ? 'eager' : 'lazy'}
            width="1108"
            height="720"
          />
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .demo-carousel {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  /* Stage first on small screens so the media isn't pushed below the buttons */
  .demo-stage {
    order: -1;
  }

  .demo-aside {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .demo-nav {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .demo-tab {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: left;
    padding: 0.6rem 0.9rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    font: inherit;
  }

  .demo-tab-label {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }

  .demo-tab-desc {
    display: none;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .demo-tab:hover .demo-tab-label {
    color: var(--sl-color-white);
  }

  .demo-tab:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .demo-tab[aria-selected='true'] {
    background-color: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
  }

  .demo-tab[aria-selected='true'] .demo-tab-label {
    color: var(--sl-color-text-accent);
  }

  /* min-width: 0 lets the media shrink with the viewport — grid items
     otherwise refuse to go below the media's intrinsic 1108px width */
  .demo-stage,
  .demo-aside {
    min-width: 0;
  }

  .demo-panel img,
  .demo-panel video {
    display: block;
    width: 100%;
    /* height: auto overrides the height="720" presentational attribute,
       which otherwise fixes images at 720px tall at narrow widths */
    height: auto;
    aspect-ratio: 1108 / 720;
    object-fit: cover;
    border-radius: 4px;
    background-color: var(--sl-color-gray-6);
  }

  .demo-panel video {
    cursor: pointer;
  }

  /* Desktop: 20/80 columns, labels stacked beside the pane */
  @media (min-width: 72rem) {
    .demo-carousel {
      grid-template-columns: 1fr 4fr;
      align-items: start;
    }

    .demo-stage {
      order: 0;
    }

    .demo-nav {
      flex-direction: column;
      overflow-x: visible;
      padding-bottom: 0;
    }

    .demo-tab-label {
      white-space: normal;
    }

    .demo-tab-desc {
      display: block;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll('.demo-carousel').forEach((carousel) => {
    const tabs = [...carousel.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...carousel.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    // Pending "advance to next clip" timer; cancelled the moment the user
    // takes over (switches tab, pauses/clicks a video) or scrolls the row away.
    let advanceTimer: ReturnType<typeof setTimeout> | undefined;
    const cancelAdvance = () => {
      clearTimeout(advanceTimer);
      advanceTimer = undefined;
    };

    const select = (index: number, focus = false) => {
      cancelAdvance();
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', i === index ? 'true' : 'false');
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
        const video = panel.querySelector('video');
        if (video && i !== index) video.pause();
      });
      const video = panels[index].querySelector('video');
      if (video && !reducedMotion.matches) video.play().catch(() => {});
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          select(event.key === 'Home' ? 0 : tabs.length - 1, true);
          return;
        }
        const step =
          event.key === 'ArrowDown' || event.key === 'ArrowRight' ? 1 :
          event.key === 'ArrowUp' || event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        select((i + step + tabs.length) % tabs.length, true);
      });
    });

    panels.forEach((panel, i) => {
      const video = panel.querySelector('video');
      if (!video) return;

      // Click anywhere on the video toggles playback — except the bottom
      // strip, where clicks belong to the native control bar. Any manual
      // toggle also stops the auto-advance chain.
      video.addEventListener('click', (event) => {
        const rect = video.getBoundingClientRect();
        if (rect.bottom - event.clientY <= 48) return;
        cancelAdvance();
        if (video.paused) video.play().catch(() => {});
        else video.pause();
      });

      // When a clip finishes, hold for 3s then advance to the next tab.
      // Stops at the last tab — no wrap back to the first. Cancelled if the
      // user takes over before it fires. Skipped under prefers-reduced-motion.
      video.addEventListener('ended', () => {
        if (reducedMotion.matches || i === panels.length - 1) return;
        cancelAdvance();
        advanceTimer = setTimeout(() => select(i + 1), 3000);
      });
    });

    // Pause this row's videos and drop any queued advance when the carousel
    // scrolls out of view
    new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) {
          cancelAdvance();
          carousel.querySelectorAll('video').forEach((video) => video.pause());
        }
      }
    }).observe(carousel);
  });
</script>
