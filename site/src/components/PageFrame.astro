---
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';
import Sidebar from 'virtual:starlight/components/Sidebar';
import type { Props } from '@astrojs/starlight/props';

// Starlight renders the sidebar only when `hasSidebar` — false for splash
// pages. The homepage is a splash page, and a reader who lands there should
// still be able to reach the nav, so it is always rendered and the header's
// hamburger toggles it. On a splash page it starts collapsed (see Header).
// Starlight's Page component also guards the sidebar *slot* with `hasSidebar`,
// so on a splash page the slot arrives empty (present but with no content,
// which also suppresses slot fallbacks) — render the same Sidebar directly
// instead (`Astro.props.sidebar` is computed for every page).
const { hasSidebar } = Astro.props;
---

<div class="page sl-flex">
	<header class="header"><slot name="header" /></header>
	<nav class="sidebar" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
		<MobileMenuToggle {...Astro.props} />
		<div id="starlight__sidebar" class="sidebar-pane">
			<div class="sidebar-content sl-flex">
				{hasSidebar ? <slot name="sidebar" /> : <Sidebar {...Astro.props} />}
			</div>
		</div>
	</nav>
	<div class="main-frame"><slot /></div>
</div>

<style>
	.page {
		flex-direction: column;
		min-height: 100vh;
	}

	.header {
		z-index: var(--sl-z-index-navbar);
		position: fixed;
		inset-inline-start: 0;
		inset-block-start: 0;
		width: 100%;
		height: var(--sl-nav-height);
		border-bottom: 1px solid var(--sl-color-hairline-shade);
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		/* The mobile menu button sits fixed at the inline start, before the
		   site title — make room for it. */
		padding-inline-start: calc(var(--sl-nav-pad-x) + var(--sl-menu-button-size) + 0.5rem);
		background-color: var(--sl-color-bg-nav);
	}

	.sidebar-pane {
		visibility: var(--sl-sidebar-visibility, hidden);
		position: fixed;
		z-index: var(--sl-z-index-menu);
		inset-block: var(--sl-nav-height) 0;
		inset-inline-start: 0;
		width: 100%;
		background-color: var(--sl-color-black);
		overflow-y: auto;
	}

	:global([aria-expanded='true']) ~ .sidebar-pane {
		--sl-sidebar-visibility: visible;
	}

	.sidebar-content {
		height: 100%;
		min-height: max-content;
		padding: 1rem var(--sl-sidebar-pad-x) 0;
		flex-direction: column;
		gap: 1rem;
	}

	@media (min-width: 50rem) {
		.sidebar-content::after {
			content: '';
			padding-bottom: 1px;
		}
	}

	.main-frame {
		padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
		padding-inline-start: var(--sl-content-inline-start);
	}

	@media (min-width: 50rem) {
		.header {
			/* The mobile menu button is gone; the header's own toggle is in flow. */
			padding-inline-start: var(--sl-nav-pad-x);
		}
		/* A splash page has no [data-has-sidebar], so Starlight never insets
		   its main frame. While its sidebar is open, inset it here. */
		:global(html:not([data-has-sidebar]):not([data-sidebar-collapsed])) .main-frame {
			padding-inline-start: var(--sl-sidebar-width);
		}
		.sidebar-pane {
			--sl-sidebar-visibility: visible;
			width: var(--sl-sidebar-width);
			background-color: var(--sl-color-bg-sidebar);
			border-inline-end: 1px solid var(--sl-color-hairline-shade);
		}
	}
</style>
