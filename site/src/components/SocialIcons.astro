---
// Custom SocialIcons override for Starlight.
// Renders GitHub and Figma Plugin links with icon + text label.
const GITHUB_URL = 'https://github.com/DirectedEdges/specs';
const FIGMA_PLUGIN_URL = 'https://www.figma.com/community/plugin/1549454283615386215/specs-2-formerly-anova';

// GitHub mark path — sourced from Starlight's built-in icon set (viewBox 0 0 24 24).
const GITHUB_PATH =
  'M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z';

// Figma logo path — viewBox 0 0 177 255 (portrait, ~0.69 aspect ratio).
const FIGMA_PATH =
  'M47.7206 95.4082C29.9906 95.4082 15.6176 109.776 15.6176 127.5C15.6176 145.224 29.9906 159.592 47.7206 159.592H80.6912V127.5V95.4082H47.7206ZM128.412 79.7959L129.279 79.7959C147.009 79.7959 161.382 65.4279 161.382 47.7041C161.382 29.9802 147.009 15.6122 129.279 15.6122H96.3088V79.7959L128.412 79.7959ZM155.448 87.602C168.429 79.0765 177 64.3908 177 47.7041C177 21.3578 155.635 0 129.279 0H96.3088H88.5H80.6912H47.7206C21.3652 0 0 21.3578 0 47.7041C0 64.3908 8.57068 79.0765 21.5515 87.602C8.57068 96.1276 0 110.813 0 127.5C0 144.187 8.57067 158.872 21.5515 167.398C8.57067 175.923 0 190.609 0 207.296C0 233.697 21.6358 255 47.9363 255C74.4764 255 96.3088 233.503 96.3088 206.862V175.204V167.398V162.796C104.785 170.505 116.05 175.204 128.412 175.204H129.279C155.635 175.204 177 153.846 177 127.5C177 110.813 168.429 96.1276 155.448 87.602ZM129.279 95.4082L128.412 95.4082C110.682 95.4082 96.3088 109.776 96.3088 127.5C96.3088 145.224 110.682 159.592 128.412 159.592H129.279C147.009 159.592 161.382 145.224 161.382 127.5C161.382 109.776 147.009 95.4082 129.279 95.4082ZM15.6176 207.296C15.6176 189.572 29.9906 175.204 47.7206 175.204H80.6912V206.862C80.6912 224.771 65.9608 239.388 47.9363 239.388C30.1515 239.388 15.6176 224.965 15.6176 207.296ZM80.6912 79.7959H47.7206C29.9906 79.7959 15.6176 65.4279 15.6176 47.7041C15.6176 29.9802 29.9906 15.6122 47.7206 15.6122H80.6912V79.7959Z';
---

<a href={GITHUB_URL} rel="me" class="social-link" aria-label="GitHub">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    class="social-icon"
  >
    <path d={GITHUB_PATH} />
  </svg>
  <span class="social-label">GitHub</span>
</a>

<a href={FIGMA_PLUGIN_URL} rel="me" class="social-link" aria-label="Figma Plugin" target="_blank">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="-5 -5 187 265"
    fill="currentColor"
    aria-hidden="true"
    class="social-icon figma-icon"
  >
    <path fill-rule="evenodd" clip-rule="evenodd" d={FIGMA_PATH} />
  </svg>
  <span class="social-label">Figma Plugin</span>
</a>

<style>
  .social-link {
    display: flex;
    align-items: center;
    gap: 0.375em;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    padding: 0.5em;
    margin: -0.5em;
    white-space: nowrap;
  }
  .social-link:hover {
    opacity: 0.66;
  }
  /* GitHub icon: square 24×24 viewBox, rendered at 1.25rem × 1.25rem */
  .social-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }
  /* Figma icon: portrait 177×255 viewBox — fix height, derive width from aspect ratio */
  .figma-icon {
    height: 1.25rem;
    width: calc(1.25rem * 187 / 265);
  }
  .social-label {
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.01em;
  }
</style>
